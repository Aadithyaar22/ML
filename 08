import numpy as np
import matplotlib.pyplot as plt

class GridWorld:

    def __init__(self):
        self.size = (3, 3)
        self.goal = (2, 2)
        self.state = (0, 0)

    def reset(self):
        self.state = (0, 0)
        return self.state

    def step(self, action):

        # Actions: Right, Down, Left, Up
        actions = [(0, 1), (1, 0), (0, -1), (-1, 0)]

        next_state = (
            self.state[0] + actions[action][0],
            self.state[1] + actions[action][1]
        )

        # Keep agent inside grid
        if 0 <= next_state[0] < 3 and 0 <= next_state[1] < 3:
            self.state = next_state

        reward = 10 if self.state == self.goal else -1

        return self.state, reward


# Create environment
env = GridWorld()

# Q-table: 3x3 grid with 4 possible actions
q_table = np.zeros((3, 3, 4))

# Hyperparameters
alpha = 0.1
gamma = 0.9
epsilon = 0.1
episodes = 1000

# Q-Learning Training
for _ in range(episodes):

    state = env.reset()
    done = False

    while not done:

        # Exploration vs Exploitation
        if np.random.rand() < epsilon:
            action = np.random.choice(4)
        else:
            action = np.argmax(q_table[state[0], state[1]])

        # Take action
        next_state, reward = env.step(action)

        # Q-Learning Update Formula
        q_table[state[0], state[1], action] += alpha * (
            reward
            + gamma * np.max(q_table[next_state[0], next_state[1]])
            - q_table[state[0], state[1], action]
        )

        # Move to next state
        state = next_state

        # Check if goal reached
        if state == env.goal:
            done = True


# Visualize Optimal Policy
fig, ax = plt.subplots(figsize=(5, 5))

ax.set_xlim(0, 3)
ax.set_ylim(0, 3)

actions = ['↑', '→', '↓', '←']

for y in range(3):
    for x in range(3):

        action = np.argmax(q_table[x, y])

        ax.text(
            y + 0.5,
            2.5 - x,
            actions[action],
            ha='center',
            va='center',
            fontsize=20
        )

# Mark Goal
ax.text(
    2.5,
    0.5,
    "G",
    ha='center',
    va='center',
    fontsize=20,
    color='green'
)

# Draw Grid
for i in range(4):
    ax.axhline(i, color='black')
    ax.axvline(i, color='black')

plt.title("Q-Learning Optimal Policy")
plt.xticks([])
plt.yticks([])
plt.show()
